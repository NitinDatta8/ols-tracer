{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ols-tracer/schema/knowledge.schema.v0.1.json",
  "title": "OLS Tracer Knowledge (v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stream",
    "sourceIndexPath",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "stream": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sourceIndexPath": {
      "type": "string",
      "pattern": "^data/cli/.+/cli-index\\.source\\.json$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "op": {
      "type": "string",
      "enum": [
        "show",
        "set",
        "delete",
        "add",
        "rpc"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "metric",
        "setting",
        "enum"
      ]
    },
    "valueType": {
      "type": "string",
      "enum": [
        "number",
        "enum",
        "string",
        "boolean"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "helperInfo",
        "lab-note",
        "inferred",
        "manual"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "meaning"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "commandId",
        "op"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "op": {
          "$ref": "#/$defs/op"
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "unit",
        "range",
        "options"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/valueType"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "oneOf": [
            {
              "$ref": "#/$defs/range"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "why_it_matters",
        "bad_pattern",
        "check_next"
      ],
      "properties": {
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "bad_pattern": {
          "type": "string",
          "minLength": 1
        },
        "check_next": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_affecting",
        "risk"
      ],
      "properties": {
        "service_affecting": {
          "type": "boolean"
        },
        "risk": {
          "$ref": "#/$defs/risk"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence",
        "lastReviewed"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "lastReviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref",
        "kind",
        "term",
        "meaning",
        "value",
        "debug",
        "impact",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "debug": {
          "$ref": "#/$defs/debug"
        },
        "impact": {
          "$ref": "#/$defs/impact"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  }
}
