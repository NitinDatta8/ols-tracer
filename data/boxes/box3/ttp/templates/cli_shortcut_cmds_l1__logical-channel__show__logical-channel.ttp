<!--
show logical-channel: its [state] table, one entry per logical channel by id. A flexgo sits on an och; a flexgdu sits
on a flexgo, in tributary slot tributary-slot-index. The config table repeats the delay-measurement mode.
-->
<group name="state">
[state] {{ _start_ }}
<group name="channels.{{ id }}">
{{ id | re("flex\\S+") | _start_ }}  {{ index | re("\\d+") }}  {{ trib-protocol }}  {{ rate-class }}  {{ assigned-channel | ORPHRASE }}  {{ tributary-slot-index | re("\\d+") }}  {{ time-slot-type }}  {{ delay-measurement-mode }}
{{ id | re("flex\\S+") | _start_ }}  {{ index | re("\\d+") }}  {{ trib-protocol }}  {{ rate-class }}  {{ assigned-channel | ORPHRASE }}  {{ time-slot-type }}  {{ delay-measurement-mode }}
</group>
</group>
