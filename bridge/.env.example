# Copy to bridge/.env (git-ignored) and fill in the login. The box's IP is entered in its physical view.
BOX_PORT=22
BOX_USER=admin
# A password (also used for RADIUS/TACACS+ keyboard-interactive logins), or a private key file.
BOX_PASSWORD=
# BOX_KEY=/Users/you/.ssh/id_ed25519
# Commands to run once after login, separated by ";"; for IIVI use "cliclient -n".
# BOX_INIT=cliclient -n
# BRIDGE_PORT=8022
# The poller (bridge/poll.json) knows a command is done when the last line of output matches this regex: the prompt.
# BOX_PROMPT=[#>$] ?$
# How long it waits for the prompt before it sends Ctrl-C, in ms.
# BOX_TIMEOUT=20000
# How many shells (CLI sessions) the poller opens to share a snapshot's commands, 1 to 8.
# BOX_WORKERS=1
# Where the templates (ttp/) and the recorded runs (runs/) live: data/boxes/<BOX_DATA_BOX> by default.
# BOX_DATA_BOX=paho-gs2000-03
# BOX_DATA_ROOT=data/boxes/paho-gs2000-03
# The Python with TTP installed (npm run bridge:setup makes bridge/.venv).
# PYTHON=bridge/.venv/bin/python
# How long a procedure that changes the box waits for a person to Approve it in the UI, in s.
# PROCEDURE_PENDING_SEC=900
