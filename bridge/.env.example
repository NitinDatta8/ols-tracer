# Copy to bridge/.env (git-ignored) and fill in the login. The box's IP is entered in its physical view.
BOX_PORT=22
BOX_USER=admin
# A password (also used for RADIUS/TACACS+ keyboard-interactive logins), or a private key file.
BOX_PASSWORD=
# BOX_KEY=/Users/you/.ssh/id_ed25519
# The box prompt as a regex, if the default (a name ending in #, > or $, or (kgdb), on its own line) misses one of its modes.
# BOX_PROMPT=\nbox1# ?$
# Commands to run once after login, separated by ";", e.g. to turn paging off.
# BOX_INIT=terminal length 0
# Seconds to wait for a command's output to end.
# BOX_TIMEOUT=30
# BRIDGE_PORT=8022
