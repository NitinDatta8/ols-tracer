{
  "name": "ols-tracer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "bridge": "node --env-file-if-exists=bridge/.env bridge/server.mjs",
    "sync:platform": "node scripts/sync-streams-chassis-from-iivi.mjs",
    "sync:cli": "node scripts/sync-cli-from-iivi.mjs",
    "sync:linecards": "node scripts/sync-linecards-from-iivi.mjs",
    "bridge:setup": "python3 -m venv bridge/.venv && bridge/.venv/bin/pip install -r bridge/requirements.txt"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
